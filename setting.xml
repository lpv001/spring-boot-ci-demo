<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
    <mirrors>
        <mirror>
            <id>nexus-public</id>
            <name>Internal Nexus</name>
            <url>http://nexus.nexus.svc.cluster.local:8081/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

    <servers>
        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_USERNAME:maven-publisher}</username>
            <password>${env.NEXUS_PASSWORD:12345678}</password>
        </server>
    </servers>
</settings>
